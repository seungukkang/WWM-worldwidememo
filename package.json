{
  "name": "wwm-worldwidememo",
  "version": "0.2.0",
  "private": true,
  "description": "WWM (WorldWideMemo) — highlight, underline, bold and annotate any web page; annotations survive page updates via tiered re-anchoring.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "e2e": "node tests/e2e/smoke.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "icons": "node scripts/make-icons.mjs",
    "store-assets": "node scripts/make-store-assets.mjs",
    "zip": "node scripts/zip.mjs",
    "release": "npm run typecheck && npm run test && npm run build:prod && npm run zip"
  },
  "dependencies": {
    "approx-string-match": "^2.0.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
